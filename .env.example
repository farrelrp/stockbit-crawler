# Daemon auto-start (for app.py / webapp mode)
# Set to true on VPS so the daemon + Telegram bot boot with the Flask app.
# Leave false locally — run run_daemon.py manually when you actually need it.
AUTO_START_DAEMON=false

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and get your token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID by sending /start to the bot
TELEGRAM_CHAT_ID=your_chat_id_here

# Heartbeat interval in minutes (default: 15, changeable at runtime via /setheartbeat)
TELEGRAM_HEARTBEAT_MINUTES=15

# 2Captcha API Key (for reCAPTCHA v3 solving during auto-login)
# Get your API key from https://2captcha.com/enterpage
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# Google Drive Upload
# OAuth credentials (recommended for personal Google Drive — no expiry)
# 1. Create OAuth Desktop credentials in Google Cloud Console
# 2. Download client_secrets.json -> place at: config_data/gdrive-oauth-client.json
# 3. Run: python3 gdrive_oauth_setup.py  (one-time, opens browser)
# 4. Token is saved automatically to gdrive-oauth-token.json
GDRIVE_OAUTH_CLIENT_FILE=config_data/gdrive-oauth-client.json
GDRIVE_OAUTH_TOKEN_FILE=config_data/gdrive-oauth-token.json

# Service account (fallback — only works with Shared Drives / Google Workspace)
GDRIVE_SERVICE_ACCOUNT_FILE=config_data/gdrive-service-account.json

# Target folder ID (from the Drive folder URL)
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
GDRIVE_DELETE_AFTER_UPLOAD=false
